@model CreateTagModel

@{
    ViewData["Title"] = "Create";
}

<h1>Создать новый тэг</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TagName" class="control-label">Название</label>
                <input asp-for="TagName" class="form-control" placeholder="Введите тэг" />
                <span asp-validation-for="TagName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Info" class="control-label">Описание</label>
                <input asp-for="Info" class="form-control" placeholder="описание" />
                <span asp-validation-for="Info" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Добавить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<a asp-action="Index">
    <input class="mt-2" type="button" value="Вернуться к списку" />
</a>