@model IEnumerable<TagPairViewModel>

@{
    ViewData["Title"] = "Index";
}

<div>
    <h2 style="float: left">Список пар тэгов</h2>
</div>

<table class="table">
    <thead>
        <tr>
            <th class="col-md-1">
                Пара тэгов
            </th>
            <th class="col-md-1">
                Частота
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="col-md-1">
                    @(item.FirstTag + " - " + item.SecondTag)
                </td>
                <td class="col-md-1">
                    @item.Frequency
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index"><input class="mt-2" type="button" value="Вернуться к списку"/></a>