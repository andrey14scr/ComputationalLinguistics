@using ComputationalLinguistics.Controllers
@model ComputationalLinguistics.Core.Dto.TagInfoDto

@{
    ViewData["Title"] = "Delete";
}

<h1>Удаление</h1>
<h3>Вы уверены, что хотите удалить тэг <i>@Model.TagName</i>?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Название
        </dt>
        <dd class="col-sm-10">
            @Model.TagName
        </dd>
        <dt class="col-sm-2">
            Описание
        </dt>
        <dd class="col-sm-10">
            @Model.Info
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TagName" />
        <input type="hidden" asp-for="Info" />
        <input type="submit" value="Подтвердить" class="btn btn-danger" />
    </form>

    <a asp-action="Index"><input class="mt-2" type="button" value="Вернуться к списку" /></a>
</div>