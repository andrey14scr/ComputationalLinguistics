@using ComputationalLinguistics.Controllers
@model WordViewModelFrom

@{
    ViewData["Title"] = "Delete";
}

<h1>Удаление</h1>
<h3>Вы уверены, что хотите удалить слово <i>@Model.WordViewModel.Content</i>?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Слово
        </dt>
        <dd class="col-sm-10">
            @Model.WordViewModel.Content
        </dd>
        <dt class="col-sm-2">
            Аннотация
        </dt>
        <dd class="col-sm-10">
            @Model.WordViewModel.Annotation
        </dd>
        <dt class="col-sm-2">
            Частота
        </dt>
        <dd class="col-sm-10">
            @Model.WordViewModel.Frequency
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="WordViewModel.Id" />
        <input type="hidden" asp-for="WordViewModel.Content" />
        <input type="hidden" asp-for="WordViewModel.Frequency" />
        <input type="submit" value="Подтвердить" class="btn btn-danger" />
    </form>

    @switch (Model.PreviousPage)
    {
        case nameof(WordsController.Index):
            <a asp-action="Index"><input class="mt-2" type="button" value="Вернуться к списку"/></a>
            break;
        case nameof(WordsController.Details):
            <a asp-action="Details" asp-route-id="@Model.WordViewModel.Id"><input class="mt-2" type="button" value="Вернуться к описанию"/></a>
            break;
    }
</div>
