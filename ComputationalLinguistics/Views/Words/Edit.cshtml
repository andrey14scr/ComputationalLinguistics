@using ComputationalLinguistics.Controllers
@model WordViewModelFrom

@{
    ViewData["Title"] = "Edit";
}

<h1>Редакция</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PreviousPage" />
            <input type="hidden" asp-for="WordViewModel.Id" />
            <input type="hidden" asp-for="WordViewModel.Frequency" />
            <div class="form-group">
                <label asp-for="WordViewModel.Content" class="control-label">Написание</label>
                <input asp-for="WordViewModel.Content" class="form-control" />
                <span asp-validation-for="WordViewModel.Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WordViewModel.Annotation" class="control-label">Аннотация</label>
                <input asp-for="WordViewModel.Annotation" class="form-control" />
                <span asp-validation-for="WordViewModel.Annotation" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@switch (Model.PreviousPage)
{
    case nameof(WordsController.Index):
        <a asp-action="Index">
            <input class="mt-2" type="button" value="Вернуться к списку"/>
        </a>
        break;
    case nameof(WordsController.Details):
        <a asp-action="Details" asp-route-id="@Model.WordViewModel.Id">
            <input class="mt-2" type="button" value="Вернуться к описанию" />
        </a>
        break;
}
