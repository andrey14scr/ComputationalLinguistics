@using ComputationalLinguistics.Controllers
@model WordViewModel
@{
    ViewData["Title"] = "Details";
}

<h1>Информация о слове <i>@Model.Content</i></h1>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">
            Слово
        </dt>
        <dd class="col-sm-9">
            @Model.Content
        </dd>
        <dt class="col-sm-3">
            Тэг
        </dt>
        <dd class="col-sm-9">
            @Model.TagName
        </dd>
        <dt class="col-sm-3">
            Частота
        </dt>
        <dd class="col-sm-9">
            @Model.Frequency
        </dd>
        <dt class="col-sm-3">
            Абсолютная частота
        </dt>
        <dd class="col-sm-9">
            @Model.AbsoluteFrequency
        </dd>
        <dt class="col-sm-3">
            Начальная форма
        </dt>
        <dd class="col-sm-9">
            @Model.Initial
        </dd>
    </dl>
</div>

<h3>Возможные формы слова <i>@Model.Content</i></h3>
<table style="width:300px; border: 1px solid black" class="table">
    <thead>
        <tr>
            <th class="col-md-1">
                Слово
            </th>
            <th class="col-md-1">
                Тэг
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var wordForm in Model.Forms.Forms)
        {
            <tr>
                <td class="col-md-1">
                    @wordForm.Word
                </td>
                <td class="col-md-1">
                    @wordForm.Tag
                </td>
            </tr>
        }
    </tbody>
</table>




<h3>Упоминания:</h3>
<ul>
    @foreach (var file in Model.WordContextFiles)
    {
        <li>
            <a asp-controller="Texts" asp-action="Details" asp-route-id="@file.TextFileId" asp-route-wordId="@Model.Id">@System.IO.Path.GetFileName(file.TextFilePath)</a>
        </li>
    }
</ul>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-previousPage="@nameof(WordsController.Details)"><input class="mt-2 btn-secondary" type="button" value="Редактировать" /></a>
    <a asp-action="Delete" asp-route-id="@Model.Id" asp-route-previousPage="@nameof(WordsController.Details)"><input class="mt-2 btn-danger" type="button" value="Удалить" /></a>
    <br />
    <a asp-action="Index"><input class="mt-2" type="button" value="Вернуться к списку" /></a>
</div>