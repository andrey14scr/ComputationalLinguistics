@using ComputationalLinguistics.Controllers
@using ComputationalLinguistics.Tools
@model WordsListViewModel

@{
    ViewData["Title"] = "Index";
}

<div>
    <h2 style="float: left">Список доступных слов</h2>
    <p style="text-align: right">
        <a asp-action="Create" class="btn btn-success">Добавить</a>
    </p>
</div>

<div>
    <form asp-action="Index">
        <div>
            <div class="d-inline-flex p-2">
                <label asp-for="SortBy">Сортировать по</label>
            </div>
            <div class="d-inline-flex p-2">
                <select class="form-select" asp-for="SortBy" id="selectSort">
                    <option value="@Variables.OnAlphabetPattern">Алфавиту ↓</option>
                    <option value="@Variables.OnAlphabetBackPattern">Алфавиту ↑</option>
                    <option value="@Variables.OnFrequencyPattern">Частоте ↑</option>
                    <option value="@Variables.OnFrequencyBackPattern">Частоте ↓</option>
                    <option value="@Variables.OnPatternPattern">Шаблону</option>
                </select>
            </div>

            @if (Model.SortBy == Variables.OnPatternPattern)
            {
                <div class="d-inline-flex p-2">
                    <input value="@Model.Pattern" asp-for="Pattern" placeholder="шаблон" id="inputPattern">
                </div>
            }
            else
            {
                <div class="d-inline-flex">
                    <input hidden value="@Model.Pattern" asp-for="Pattern" placeholder="шаблон" id="inputPattern">
                </div>
            }

            <div class="d-inline-flex p-2">
                <input type="submit" value="Применить">
            </div>
        </div>
    </form>
</div>

<div id="div-table" style="overflow-y: auto;height: 72vh;" onscroll="scrolled('@Model.WordsBlockSize', '@Model.SortBy', '@Model.Pattern')">
    <table class="table table-striped">
        <thead style="position: sticky;top: 0; background: gray;">
        <tr>
            <th class="col-md-5" style="position: sticky;top: 0;">
                Слово
            </th>
            <th class="col-md-1" style="position: sticky;top: 0;">
                Частота
            </th>
            <th class="col-md-5" style="position: sticky;top: 0;">
                Действия
            </th>
        </tr>
        </thead>
        <tbody id="tableBody">
        @foreach (var item in Model.Words)
        {
            <tr>
                <td class="col-md-5">
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
                <td class="col-md-1">
                    @Html.DisplayFor(modelItem => item.Frequency)
                </td>
                <td class="col-md-5">
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-frequency="@item.Frequency"><input type="button" value="Описание" class="btn-info"/></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-previousPage="@nameof(WordsController.Index)"><input type="button" value="Редактировать" class="btn-secondary"/></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" asp-route-previousPage="@nameof(WordsController.Index)"><input type="button" value="Удалить" class="btn-danger"/></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts
{
    <script src="~/js/words.js"></script>
}