@using ComputationalLinguistics.Controllers
@model IEnumerable<WordViewModel>

@{
    ViewData["Title"] = "Index";
}

<div>
    <h2 style="float: left">Список доступных слов</h2>
    <p style="text-align: right">
        <a asp-action="Create" class="btn btn-success" >Добавить</a>
    </p>
</div>


<table class="table">
    <thead>
        <tr>
            <th>
                Слово
            </th>
            <th>
                Частота
            </th>
            <th>
                Действия
            </th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) 
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Content)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Frequency)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id"><input type="button" value="Описание" class="btn-info" /></a>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-from="@nameof(WordsController.Index)"><input type="button" value="Редактировать" class="btn-secondary" /></a>
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-from="@nameof(WordsController.Index)"><input type="button" value="Удалить" class="btn-danger" /></a>
            </td>
        </tr>
    }
    </tbody>
</table>
