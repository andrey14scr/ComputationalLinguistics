@using ComputationalLinguistics.Controllers
@model IEnumerable<WordViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Слово
            </th>
            <th>
                Частота
            </th>
            <th>
                Действия
            </th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) 
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Content)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Frequency)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-from="@nameof(WordsController.Index)">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-from="@nameof(WordsController.Index)">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
