@using System.Text.Json
@model TextFileInfoViewModel

@{
    ViewData["Title"] = "Details";
}

@if (!string.IsNullOrWhiteSpace(Model.Word))
{
    <button if="prevWordBtn" onclick="findWord('prev')">Пред.</button>
    <span> <i> @Model.Word </i> </span>
    <button if="nextWordBtn" onclick="findWord('next')">След.</button>   
}
<h2>@Model.FileName</h2>
<textarea readonly class="form-control" id="text" name="textFile" style="width: 100%; height: 78vh;">@Model.Text</textarea>

<a asp-action="Delete" asp-route-id="@Model.Id"><input class="mt-2 btn-danger" type="button" value="Удалить" /></a>

@section Scripts
{
    <script>
        var indexes = @Html.Raw(JsonSerializer.Serialize(Model.Seeks));
        var word = @Html.Raw(JsonSerializer.Serialize(Model.Word));
    </script>
    <script src="~/js/wordsInText.js"></script>
}