@model IEnumerable<TextFileViewModel>

@{
    ViewData["Title"] = "Index";
}

<h3>Работа с файлами текстов</h3>

<form asp-action="Add" asp-controller="Texts" method="post" enctype="multipart/form-data">
    <div class="mb-3" style="width: 500px">
        <label for="formFile" class="form-label">Выберите файл для загрузки</label>
        <input class="form-control" type="file" id="formFile" name="uploadedFile">
    </div>
    <input type="submit" class="btn btn-light" value="Загрузить" />
</form>

<br/>
<h3>Все файлы</h3>
@foreach (var file in Model)
{
    <p>
        <span>&bull; @System.IO.Path.GetFileName(file.FilePath)</span>
    </p>
}